# TeleWyz E-Care Environment Configuration

# Server
PORT=3000
NODE_ENV=development
APP_NAME=TeleWyz E-Care Backend
API_VERSION=v1
MAINTENANCE_MODE=false

# CORS
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telewyz_ecare?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# Authentication & JWT
JWT_SECRET=telewyz-super-secret-jwt-key-change-in-production-min32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=telewyz-super-secret-refresh-key-change-in-production-min32chars
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# Firebase Authentication (Mockable in local/test)
FIREBASE_PROJECT_ID=telewyz-ecare
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@telewyz-ecare.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & Webhook Signatures
PAYMENT_WEBHOOK_SECRET=telewyz-payment-webhook-secret-key-32chars
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External Integration Mocks
USE_MOCK_BSS=true
USE_MOCK_IAM=true
USE_MOCK_PAYMENT=true
USE_MOCK_SMS=true
USE_MOCK_EMAIL=true
USE_MOCK_KYC=true
USE_MOCK_LOGISTICS=true
USE_MOCK_DMP=true
USE_MOCK_COMMUNITY=true
USE_MOCK_CVM=true
USE_MOCK_DWH=true

# Logging
LOG_LEVEL=info
