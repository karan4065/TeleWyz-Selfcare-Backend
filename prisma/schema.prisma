datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  PREPAID
  POSTPAID
}

enum SubscriberStatus {
  ACTIVE
  SUSPENDED
  BARRED
  PENDING_KYC
  DEACTIVATED
}

enum UserRole {
  SUBSCRIBER
  AGENT
  ADMIN
}

enum SimType {
  PHYSICAL
  ESIM
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ActivationStatus {
  PENDING
  ACTIVE
  FAILED
}

enum MnpStatus {
  SUBMITTED
  VALIDATED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderType {
  SIM_PURCHASE
  RECHARGE
  BILL_PAYMENT
  MNP
  PLAN_SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Subscriber {
  id               String            @id @default(uuid())
  msisdn           String            @unique
  imsi             String?           @unique
  email            String?
  firstName        String
  lastName         String
  accountType      AccountType       @default(PREPAID)
  status           SubscriberStatus  @default(ACTIVE)
  role             UserRole          @default(SUBSCRIBER)
  loyaltyPoints    Int               @default(0)
  firebaseUid      String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sessions             Session[]
  associatedAccounts   AssociatedAccount[]
  simOrders            SimOrder[]
  mnpRequests          MnpRequest[]
  orders               Order[]
  subscriptions        SubscriptionRecord[]
  supportTickets       SupportTicket[]

  @@index([msisdn])
  @@index([email])
}

model Session {
  id           String      @id @default(uuid())
  subscriberId String
  token        String      @unique
  refreshToken String      @unique
  deviceId     String?
  deviceType   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revoked      Boolean     @default(false)
  createdAt    DateTime    @default(now())

  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([token])
}

model OtpCode {
  id            String    @id @default(uuid())
  msisdn        String
  codeHash      String
  purpose       String    // LOGIN, LINK_ACCOUNT, SIM_ACTIVATION, TRANSACTION
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  expiresAt     DateTime
  cooldownUntil DateTime
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([msisdn, purpose])
}

model AssociatedAccount {
  id                  String      @id @default(uuid())
  primarySubscriberId String
  secondaryMsisdn     String
  relationship        String?     // FAMILY, BUSINESS, SECONDARY
  verified            Boolean     @default(false)
  permissions         String[]    // VIEW_BALANCE, RECHARGE, MANAGE_BUNDLES
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  primarySubscriber   Subscriber  @relation(fields: [primarySubscriberId], references: [id], onDelete: Cascade)

  @@unique([primarySubscriberId, secondaryMsisdn])
  @@index([primarySubscriberId])
}

model NumberReservation {
  id            String    @id @default(uuid())
  msisdn        String    @unique
  category      String    // NORMAL, SILVER, GOLD, PLATINUM
  price         Decimal   @default(0.0)
  reservedById  String?   // Subscriber ID or guest identifier
  status        String    @default("RESERVED") // AVAILABLE, RESERVED, ASSIGNED, EXPIRED, CANCELLED
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model SimOrder {
  id               String            @id @default(uuid())
  orderNumber      String            @unique
  msisdn           String
  simType          SimType           @default(PHYSICAL)
  deliveryAddress  String?
  kycStatus        KycStatus         @default(PENDING)
  kycReference     String?
  activationStatus ActivationStatus  @default(PENDING)
  iccid            String?
  subscriberId     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  subscriber       Subscriber?       @relation(fields: [subscriberId], references: [id])

  @@index([orderNumber])
  @@index([msisdn])
}

model MnpRequest {
  id              String      @id @default(uuid())
  msisdn          String
  donorOperator   String
  donorAccountNum String?
  subscriberId    String?
  simType         SimType     @default(PHYSICAL)
  selectedPlanId  String?
  status          MnpStatus   @default(SUBMITTED)
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  subscriber      Subscriber? @relation(fields: [subscriberId], references: [id])

  @@index([msisdn])
  @@index([status])
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  transactionId     String        @unique
  orderId           String?
  msisdn            String
  amount            Decimal
  currency          String        @default("NGN")
  paymentMethod     String        // CARD, USSD, BANK_TRANSFER, WALLET
  status            PaymentStatus @default(PENDING)
  gatewayReference  String?       @unique
  idempotencyKey    String?       @unique
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([transactionId])
  @@index([msisdn])
  @@index([status])
}

model RechargeRecord {
  id             String    @id @default(uuid())
  transactionId  String    @unique
  msisdn         String
  amount         Decimal
  rechargeType   String    // AIRTIME, DATA, VOICE
  bundleId       String?
  status         String    @default("SUCCESS")
  createdAt      DateTime  @default(now())

  @@index([msisdn])
  @@index([transactionId])
}

model SubscriptionRecord {
  id             String      @id @default(uuid())
  subscriberId   String
  msisdn         String
  planOrBundleId String
  type           String      // PLAN, ADDON
  status         String      @default("ACTIVE") // ACTIVE, CANCELLED, EXPIRED
  startDate      DateTime    @default(now())
  endDate        DateTime?
  autoRenew      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subscriber     Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([msisdn])
}

model Order {
  id            String              @id @default(uuid())
  orderNumber   String              @unique
  subscriberId  String?
  msisdn        String
  type          OrderType
  status        OrderStatus         @default(PENDING)
  totalAmount   Decimal             @default(0.0)
  currency      String              @default("NGN")
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  subscriber    Subscriber?         @relation(fields: [subscriberId], references: [id])
  statusHistory OrderStatusHistory[]

  @@index([orderNumber])
  @@index([msisdn])
  @@index([createdAt])
}

model OrderStatusHistory {
  id             String      @id @default(uuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  reason         String?
  changedBy      String?
  createdAt      DateTime    @default(now())

  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model NotificationRecord {
  id         String              @id @default(uuid())
  recipient  String              // MSISDN or email
  channel    NotificationChannel
  template   String
  subject    String?
  body       String
  status     NotificationStatus  @default(PENDING)
  error      String?
  createdAt  DateTime            @default(now())

  @@index([recipient])
  @@index([status])
}

model IdempotencyRecord {
  id             String    @id @default(uuid())
  key            String    @unique
  method         String
  path           String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([key])
  @@index([expiresAt])
}

model AuditLog {
  id            String    @id @default(uuid())
  action        String
  resource      String
  actorId       String?
  actorRole     String?
  ipAddress     String?
  correlationId String?
  details       Json?
  createdAt     DateTime  @default(now())

  @@index([action])
  @@index([correlationId])
  @@index([createdAt])
}

model SupportTicket {
  id           String      @id @default(uuid())
  ticketNumber String      @unique
  subscriberId String?
  msisdn       String
  category     String      // BILLING, NETWORK, SIM, VAS, GENERAL
  subject      String
  description  String
  status       String      @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id])

  @@index([ticketNumber])
  @@index([msisdn])
}
